# Vivado generated build products and caches
.Xil/
*.cache/
*.runs/
*.sim/
*.hw/
*.ip_user_files/
*.jou
*.log
*.str
*.pb
*.dcp
*.bin
*.hdf
*.xsa
*.wdb
*.wcfg
*.backup.*

# SDK workspace state and compiled outputs; keep source/project metadata
**/.metadata/
**/.sdk/
**/RemoteSystemsTempFiles/
**/webtalk/
# Keep ELF in build roots while ignoring other compiler products.
**/Debug/*
!**/Debug/*.elf
**/Release/*
!**/Release/*.elf
*.o
*.a
*.elf.size
*.map
*.zip

# Python environments and recordings
__pycache__/
*.py[cod]
.venv/
venv/
*.npyseq

# Local AI agent caches, sessions, history and generated status/memory
.claude/
.codex/
.agent/
.agents/
.gemini/
.cursor/
.aider*
.continue/
.roo/
.cline/
PROJECT_MEMORY.md
PROJECT_MEMORY.original.md
CLAUDE.local.md
AGENTS.local.md
*.code-workspace

# Reusable FPGA programming artifacts from the active Vivado implementation.
# Reopen ignored parent directories explicitly; keep other run products ignored.
!i2s_beamformer.runs/
i2s_beamformer.runs/*
!i2s_beamformer.runs/impl_1/
i2s_beamformer.runs/impl_1/*
!i2s_beamformer.runs/impl_1/*.bit

# SDK hardware description accompanies the active BIT/ELF for SDK/JTAG restore.
!i2s_beamformer.sdk/design_1_wrapper_hw_platform_3/system.hdf
